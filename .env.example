# Vite mode for the Builder deployment (the public-site build overrides this to false).
VITE_BUILDER=true

# Public browser configuration. A publishable key is designed to be visible in the site bundle;
# database RLS and Supabase Auth policies must protect all writes.
VITE_SUPABASE_URL=https://ymudxqnprtbyshtmtumz.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-the-project-publishable-key

# Never put a service_role/secret key, database password, or personal access token in a VITE_* variable.

